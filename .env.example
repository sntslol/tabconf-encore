# Server-only. Never prefix these with NEXT_PUBLIC_.
PETITION_API_URL=https://your-data-service.chatgpt.site
PETITION_API_SECRET=your-shared-secret
PETITION_SERVICE_TOKEN=your-sites-service-access-token
# Owner-only message approvals. Use a randomly generated value of 32+ characters.
PETITION_ADMIN_PASSWORD=your-randomly-generated-moderator-password
# Set to the website's public origin when attaching a custom domain.
NEXT_PUBLIC_SITE_URL=https://savetabconf.com
